{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/page.ts": {
      "includeFiles": "{dist/index.html,supabase/siteContent.seed.json}"
    }
  },
  "routes": [
    {
      "src": "/curs/?",
      "has": [{ "type": "host", "value": "www.ivconcept.ro" }],
      "status": 308,
      "headers": { "Location": "https://course.ivconcept.ro/" }
    },
    {
      "src": "/curs/?",
      "has": [{ "type": "host", "value": "ivconcept.ro" }],
      "status": 308,
      "headers": { "Location": "https://course.ivconcept.ro/" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "course.ivconcept.ro" }],
      "dest": "/api/page.ts"
    },
    {
      "src": "/(produse(?:/.*)?|galerie-foto/?|curs/?|confidentialitate/?|termeni/?|admin(?:/.*)?)",
      "dest": "/api/page.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
